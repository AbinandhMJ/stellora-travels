+
+/* Coast-road journey. Default (mobile, reduced motion, no JS): a plain grid of destination cards. Desktop with motion adds .is-pinned. */
+.journey-stage{position:relative}.journey-map{display:none}
+.journey-card .destination{grid-row:auto;min-height:310px}
+.journey-cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:22px}
+.journey-card{isolation:isolate}.journey-card:first-child{grid-row:span 2}.journey-card .destination{display:block;height:100%}.journey-card:first-child .destination{min-height:650px}
+.journey-map .journey-path-bg{fill:none;stroke:#102a5026;stroke-width:3;stroke-dasharray:2 9;stroke-linecap:round}
+.journey-map .journey-path{fill:none;stroke:var(--navy);stroke-width:4;stroke-linecap:round}
+.journey-dot{fill:#fff;stroke:var(--navy);stroke-width:3}
+.journey-label{font:700 15px var(--font-heading);fill:var(--navy);letter-spacing:-.02em}
+.journey-car circle:first-child{fill:var(--yellow);stroke:#fff;stroke-width:3}.journey-car path,.journey-car circle:not(:first-child){fill:var(--navy)}
+.journey.is-pinned .journey-stage{display:grid;grid-template-columns:.8fr 1.2fr;gap:36px;grid-template-rows:minmax(0,1fr);height:min(620px,calc(100vh - 150px));margin-top:30px}
+.journey.is-pinned .journey-map{display:block;width:100%;height:100%;min-height:0;overflow:visible}
+.journey.is-pinned .journey-cards{position:relative;display:block;height:100%}
+.journey.is-pinned .journey-card{position:absolute;inset:0}.journey.is-pinned .journey-card:first-child{grid-row:auto}
+.journey.is-pinned .journey-card .destination,.journey.is-pinned .journey-card:first-child .destination{min-height:0;height:100%}
+.journey.is-pinned .journey-card .destination>div{bottom:36px;left:36px}.journey.is-pinned .journey-card .destination h3{font-size:44px}.journey.is-pinned .journey-card .destination span{font-size:13px;letter-spacing:.1em;text-transform:uppercase}
+.journey.is-pinned .journey-card .destination p{font-size:15px}
+@media(max-width:1023px){.journey-cards{grid-template-columns:1fr 1fr}.journey-card:first-child{grid-row:auto;grid-column:1/-1}.journey-card:first-child .destination{min-height:340px}}
+@media(max-width:767px){.journey-cards{gap:14px}.journey-card .destination{min-height:260px}.journey-card:first-child .destination{min-height:300px}}
+
+/* Quick-form WhatsApp link, how it works, FAQ */
+.quick-wa{text-align:center;margin:14px auto 0;font-size:14px}.quick-wa .text-link{color:var(--navy)}
+.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
+.step{background:var(--soft);border-radius:var(--radius);padding:34px 32px}.step h3{margin:18px 0 8px;font-size:22px}
+.step-num{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:var(--yellow);color:var(--navy);font:800 17px var(--font-heading)}
+.faq-list{max-width:820px;margin:0 auto}
+.faq-list details{border-bottom:1px solid var(--line)}.faq-list summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 4px;font:700 20px/1.35 var(--font-heading);letter-spacing:-.02em;color:var(--navy)}
+.faq-list summary::-webkit-details-marker{display:none}
+.faq-list summary:after{content:'+';flex-shrink:0;width:34px;height:34px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:500;transition:transform .25s,background .2s}
+.faq-list details[open] summary:after{transform:rotate(45deg);background:var(--yellow)}
+.faq-list details p{padding:0 54px 26px 4px;font-size:17px}
+@media(max-width:1023px){.steps{grid-template-columns:1fr}.faq-list summary{font-size:18px}.faq-list details p{padding-right:4px;font-size:16px}}
